---
import { Image } from "astro:assets";
import doñaDomingaImg from "../assets/about/doña-dominga.png";

// Historia real de la familia, provista por el cliente (folleto Mallarauco.cl)
const historia = [
  {
    title: "Todo comenzó con una galleta campesina",
    text: "Mi abuelo elaboraba una galleta tradicional, un gran pan que se entregaba a los trabajadores del campo como parte de su derecho, para sus familias. Era hecha en grandes hornos de leña con mucho esfuerzo y dedicación.",
  },
  {
    title: "El legado continúa",
    text: "Tras un accidente en los hornos que le hizo perder la vista, mi abuelo dejó este oficio en manos de mi papá, quien mantuvo la tradición y siguió horneando con el mismo amor y compromiso de siempre.",
  },
  {
    title: "De la bicicleta al sueño de tener un local",
    text: "Con empanadas hechas en casa, recorrí en bicicleta las calles de Mallarauco para ofrecer lo mejor de nuestra cocina. Poco a poco, con esfuerzo y perseverancia, ese sueño tomó forma.",
  },
  {
    title: "Un sueño que se hizo realidad",
    text: "En 1993 abrimos nuestro local, consolidando un espacio familiar dedicado a la gastronomía chilena, con sabor casero y corazón de campo. Así nació Doña Dominga.",
  },
];
---

{
  /* Se renderiza dentro de la sección "nosotros" compartida con Values (index.astro) */
}
<div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter mb-24">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <!-- Imagen con frame decorativo -->
    <div class="relative">
      <!-- Frame decorativo -->
      <div
        class="absolute -top-4 -left-4 w-2/3 h-2/3 border-l-4 border-t-4 border-primary-container/30 pointer-events-none z-10"
      >
      </div>
      <div
        class="absolute -bottom-4 -right-4 w-2/3 h-2/3 border-r-4 border-b-4 border-primary-container/10 pointer-events-none z-10"
      >
      </div>

      <!-- Imagen -->
      <Image
        src={doñaDomingaImg}
        alt="El corazón de Doña Dominga"
        class="w-full h-120 object-cover relative z-0"
      />

      <!-- Badge flotante -->
      <div
        class="absolute bottom-6 right-6 z-20 glass-card px-4 py-3 text-center box-glow"
      >
        <span
          class="block text-display-lg font-headline-lg text-primary-container font-bold leading-none"
          data-count-to="30"
          data-count-suffix="+"
          >30+</span
        >
        <span
          class="block text-label-sm text-on-surface-variant uppercase tracking-wider mt-1"
          >Años de historia</span
        >
      </div>

      <!-- Estrellas + familias: debajo de la imagen -->
      <div class="mt-6">
        <div class="flex items-center gap-1 mb-2">
          {
            Array.from({ length: 5 }).map(() => (
              <span class="material-symbols-outlined icon-filled text-primary-container text-xl">
                star
              </span>
            ))
          }
        </div>
        <p class="text-on-surface-variant text-label-sm">
          <span
            data-count-to="500"
            data-count-prefix="+"
            >+500</span
          > familias nos han visitado
        </p>
      </div>
    </div>

    <!-- Texto -->
    <div>
      <span
        class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block mb-4"
      >
        Quiénes somos
      </span>

      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6"
      >
        Un legado en<br />Mallarauco
      </h2>

      <p class="text-on-surface-variant text-body-md leading-relaxed mb-8">
        Desde 1993, Doña Dominga ha sido mucho más que un restaurante: es un
        símbolo de trabajo familiar, tradición, sabor chileno y encuentro en el
        corazón del Valle de Mallarauco.
      </p>

      <!-- Línea de tiempo: historia real de la familia -->
      <div class="space-y-5 mb-8">
        {
          historia.map((paso, i) => (
            <div
              class="flex gap-4 reveal"
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <div class="flex flex-col items-center pt-1.5">
                <span class="w-2.5 h-2.5 bg-primary-container shrink-0" />
                {i < historia.length - 1 && (
                  <span class="w-px flex-1 bg-primary-container/20 mt-1.5" />
                )}
              </div>
              <div class="pb-1">
                <h3 class="font-headline-lg text-on-surface text-base md:text-lg font-bold mb-1">
                  {paso.title}
                </h3>
                <p class="text-on-surface-variant text-sm leading-relaxed">
                  {paso.text}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

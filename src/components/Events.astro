---
import { Image } from "astro:assets";
import SocialIcon from "./SocialIcon.astro";
import { allEvents, invitedArtists, todayIso } from "../data/events";
import potenciaImg from "../assets/events/potencia.webp";

// Fecha local del build — NO usar toISOString (desfasa el día en Chile)
const buildTodayIso = todayIso();

// El próximo evento viene de Google Sheets (client-side, ver <script> abajo).
// Los "últimos eventos" (curados a mano) siguen estáticos en events.ts.
const past = allEvents.filter((ev) => ev.iso < buildTodayIso);

// Mientras Google Sheets no esté configurado (PUBLIC_APPS_SCRIPT_URL sigue
// siendo el placeholder), se hardcodea acá el próximo evento tal como
// estaba cargado en Supabase — el <script> de abajo lo sobreescribe solo
// en cuanto el fetch a Sheets empiece a traer datos reales.
const FALLBACK_FEATURED_EVENT = {
  artista: "Potencia",
  genero: "Cumbia",
  fecha: "2026-08-08",
  hora: "20:30:00",
};

function formatFechaBuild(iso: string): string {
  const [y, m, d] = iso.split("-").map(Number);
  const date = new Date(y, m - 1, d);
  const label = date.toLocaleDateString("es-CL", {
    weekday: "short",
    day: "numeric",
    month: "short",
  });
  return label.charAt(0).toUpperCase() + label.slice(1).replace(".", "");
}

const featuredMeta = `${FALLBACK_FEATURED_EVENT.genero} · ${formatFechaBuild(FALLBACK_FEATURED_EVENT.fecha)} · ${FALLBACK_FEATURED_EVENT.hora.slice(0, 5)} hrs`;
---

<section
  id="eventos"
  class="py-20 md:py-section-gap bg-surface-container-low"
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <!-- Header -->
    <div class="text-center mb-14">
      <span
        class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block mb-4"
      >
        Cartelera
      </span>
      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface"
      >
        Próximos eventos
      </h2>
    </div>

    <!-- Próximo evento: un único destacado. Arranca con el fallback hardcodeado
         (ver frontmatter) y el <script> de abajo lo actualiza si Google Sheets
         ya está configurado y trae un evento futuro real. -->
    <div
      data-featured-event
      class="reveal relative max-w-xs mx-auto mb-20"
    >
      {/* Frame decorativo, mismo lenguaje visual que los platos destacados del Menú y Servicios */}
      <div class="absolute -top-3 -left-3 w-1/3 h-1/3 border-l-4 border-t-4 border-primary-container/30 pointer-events-none z-10" />
      <div class="absolute -bottom-3 -right-3 w-1/3 h-1/3 border-r-4 border-b-4 border-primary-container/10 pointer-events-none z-10" />

      <div class="card-lift group aspect-3/4 overflow-hidden bg-surface-container-high">
        <Image
          data-featured-image
          src={potenciaImg}
          alt={FALLBACK_FEATURED_EVENT.artista}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      </div>
      <div class="mt-5 text-center">
        <span
          class="text-primary-container text-label-sm font-bold uppercase tracking-wider block mb-1"
        >
          Próximo evento
        </span>
        <h3
          class="font-headline-lg text-on-surface text-lg md:text-xl font-bold"
          data-featured-artist
        >
          {FALLBACK_FEATURED_EVENT.artista}
        </h3>
        <p
          class="text-on-surface-variant text-sm mt-1"
          data-featured-meta
        >
          {featuredMeta}
        </p>
        <a
          href="#reserva"
          class="btn-shine inline-block mt-4 px-6 py-2 bg-primary-container text-on-primary-container text-xs font-bold tracking-widest uppercase text-center hover:brightness-110 active:scale-95 transition-all"
        >
          Reservar
        </a>
      </div>
    </div>

    <!-- Estado sin eventos futuros: oculto por defecto (ya hay un evento hardcodeado arriba) -->
    <div
      data-no-events
      class="hidden reveal border border-primary-container/15 bg-surface-container text-center px-6 py-14 mb-20 max-w-2xl mx-auto"
    >
      <span
        class="material-symbols-outlined text-primary-container text-4xl mb-4"
        >calendar_month</span
      >
      <h3
        class="font-headline-lg text-on-surface text-2xl md:text-3xl font-bold mb-3"
      >
        Estamos preparando la próxima fecha
      </h3>
      <p class="text-on-surface-variant mb-8 max-w-md mx-auto">
        Muy pronto anunciaremos un nuevo show en la terraza. Escríbenos por
        WhatsApp y te avisamos con anticipación.
      </p>
      <a
        href="https://wa.me/56974131205?text=Hola!%20Quiero%20saber%20cuándo%20es%20el%20próximo%20evento"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shine inline-block px-10 py-3 bg-primary-container text-on-primary-container text-sm font-bold tracking-widest uppercase hover:brightness-110 active:scale-95 transition-all"
      >
        Avísame del próximo evento
      </a>
    </div>

    <!-- Últimos eventos -->
    <div class="text-center mb-10">
      <span
        class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block mb-4"
      >
        Así se vive la terraza
      </span>
      <h3
        class="font-headline-lg text-on-surface text-2xl md:text-3xl font-bold"
      >
        Eventos destacados
      </h3>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 sm:gap-5 md:gap-6">
      {
        past.map((ev, i) => (
          <div class="reveal relative" style={`--reveal-delay: ${i * 100}ms`}>
            {/* Frame decorativo, mismo lenguaje visual que los platos destacados del Menú y Servicios */}
            <div class="absolute -top-3 -left-3 w-1/3 h-1/3 border-l-4 border-t-4 border-primary-container/30 pointer-events-none z-10" />
            <div class="absolute -bottom-3 -right-3 w-1/3 h-1/3 border-r-4 border-b-4 border-primary-container/10 pointer-events-none z-10" />

            <div
              class:list={[
                "card-lift group w-full aspect-3/4 overflow-hidden flex items-center justify-center",
                ev.image ? "bg-surface-container-high" : "bg-surface-container-high border border-dashed border-primary-container/20",
              ]}
            >
              {ev.image ? (
                <Image
                  src={ev.image}
                  alt={ev.artist}
                  width={540}
                  height={720}
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <span class="material-symbols-outlined text-on-surface-variant/25 text-5xl">
                  event
                </span>
              )}
            </div>
            <div class="mt-4 text-center">
              <h4 class="font-headline-lg text-on-surface text-base md:text-lg font-bold">
                {ev.artist}
              </h4>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Artistas invitados: chips, sin orden particular -->
    <div class="mt-14 pt-10 border-t border-primary-container/10 reveal">
      <div class="text-center mb-6">
        <span
          class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block"
        >
          Quiénes nos han visitado
        </span>
      </div>
      <div class="glass-card max-w-3xl mx-auto p-6 md:p-8">
        <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:justify-center sm:gap-2.5">
          {
            invitedArtists.map((name) => (
              <span class="flex sm:inline-flex items-center justify-center text-center px-3.5 py-2 bg-surface-container border border-primary-container/15 text-on-surface-variant text-sm hover:border-primary-container/50 hover:text-on-surface transition-colors">
                {name}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <!-- CTA WhatsApp -->
    <div class="text-center mt-10">
      <a
        href="https://wa.me/56974131205?text=Hola!%20Quiero%20saber%20más%20sobre%20la%20cartelera%20de%20eventos"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 hover:gap-3 text-primary-container font-semibold text-base md:text-lg hover:brightness-110 transition-all"
      >
        <SocialIcon
          platform="whatsapp"
          class="w-5 h-5 shrink-0"
        />
        <span
          class="underline underline-offset-4 decoration-primary-container/40 group-hover:decoration-primary-container transition-colors"
          >Consultar por más fechas vía WhatsApp</span
        >
      </a>
    </div>
  </div>
</section>

<script>
  import { fetchTable } from "../lib/sheets";
  import { todayIso } from "../data/events";

  interface Evento {
    artista: string;
    genero: string | null;
    fecha: string;
    hora: string;
    descripcion: string | null;
    imagen_url: string | null;
  }

  function formatFecha(iso: string): string {
    const [y, m, d] = iso.split("-").map(Number);
    const date = new Date(y, m - 1, d);
    const label = date.toLocaleDateString("es-CL", {
      weekday: "short",
      day: "numeric",
      month: "short",
    });
    return label.charAt(0).toUpperCase() + label.slice(1).replace(".", "");
  }

  // Progressive enhancement: mientras Google Sheets no esté configurado esto
  // falla en silencio y se deja el evento hardcodeado del build (ver
  // frontmatter de Events.astro) tal cual está en el HTML. En cuanto
  // PUBLIC_APPS_SCRIPT_URL apunte a un Apps Script real con un evento
  // futuro cargado, esto lo sobreescribe solo.
  async function loadFeaturedEvent() {
    const featuredEl = document.querySelector<HTMLElement>(
      "[data-featured-event]",
    );
    if (!featuredEl) return;

    let rows: Evento[];
    try {
      rows = await fetchTable<Evento>("eventos");
    } catch {
      return;
    }

    const today = todayIso();
    const ev = rows
      .filter((r) => r.fecha >= today)
      .sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora))[0];

    if (!ev) return;

    const img = featuredEl.querySelector<HTMLImageElement>(
      "[data-featured-image]",
    );
    if (img && ev.imagen_url) {
      img.src = ev.imagen_url;
      img.alt = ev.artista;
    }
    const artistaEl = featuredEl.querySelector("[data-featured-artist]");
    if (artistaEl) artistaEl.textContent = ev.artista;
    const metaEl = featuredEl.querySelector("[data-featured-meta]");
    if (metaEl) {
      const genero = ev.genero ?? ev.descripcion;
      const fechaHora = `${formatFecha(ev.fecha)} · ${ev.hora.slice(0, 5)} hrs`;
      metaEl.textContent = genero ? `${genero} · ${fechaHora}` : fechaHora;
    }
  }

  loadFeaturedEvent();
</script>

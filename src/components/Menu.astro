---
import { Image } from "astro:assets";
import flatIronImg from "../assets/menu/destacado-2.webp";
import corteParrillaImg from "../assets/menu/destacado-1.webp";
import restaurantImg from "../assets/menu/restaurant.webp";
import carrusel1 from "../assets/menu/carrusel-1.webp";
import carrusel2 from "../assets/menu/carrusel-2.webp";
import carrusel3 from "../assets/menu/carrusel-3.webp";
import carrusel4 from "../assets/menu/carrusel-4.webp";
import carrusel5 from "../assets/menu/carrusel-5.webp";
import carrusel6 from "../assets/menu/carrusel-6.webp";
import carrusel7 from "../assets/menu/carrusel-7.webp";
import carrusel8 from "../assets/menu/carrusel-8.webp";
import carrusel9 from "../assets/menu/carrusel-9.webp";

// TODO: reemplazar el placeholder de Filete de Pollo por su foto real cuando esté disponible.
// Estas 3 fotos son solo vitrina visual — no tienen conexión con la carta real
// (public/carta-restaurant.html), que puede variar por día. El nombre es fijo,
// no viene de src/data/menu.ts.
const dishes = [
  { name: "Flat Iron a lo Pobre", image: flatIronImg },
  { name: "Filete de Pollo a la Grilla", image: restaurantImg },
  { name: "Corte a la Parrilla", image: corteParrillaImg },
];

const strip = [
  carrusel1,
  carrusel2,
  carrusel3,
  carrusel4,
  carrusel5,
  carrusel6,
  carrusel7,
  carrusel8,
  carrusel9,
];
// Duplicado para el loop infinito del carrusel (misma técnica que Testimonials.astro)
const stripLoop = [...strip, ...strip];
---

<section
  id="menu"
  class="py-20 md:py-section-gap bg-background border-t border-primary-container/10 md:border-t-0"
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <!-- Layout tipo "Best Sellers": columna de texto + 3 platos destacados -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 md:gap-6 items-stretch">
      <!-- Columna de texto -->
      <div class="md:col-span-1 flex flex-col justify-between reveal">
        <div>
          <span
            class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block mb-4"
          >
            Menú
          </span>
          <h2
            class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6"
          >
            Nuestra Carta
          </h2>
          <!-- <p class="text-on-surface-variant text-body-md leading-relaxed">
            Una selección curada que celebra los ingredientes locales de
            Mallarauco. Recomendaciones de la casa, para cada momento del día.
          </p> -->
        </div>
        <a
          href="/carta-restaurant.html"
          target="_blank"
          rel="noopener"
          class="group mt-8 md:mt-0 inline-flex items-center gap-2 hover:gap-3 text-on-surface font-semibold text-base md:text-lg transition-all"
        >
          <span
            class="underline underline-offset-4 decoration-primary-container/40 group-hover:decoration-primary-container transition-colors"
            >Ver Carta Completa</span
          >
          <span class="material-symbols-outlined text-xl text-primary-container"
            >north_east</span
          >
        </a>
      </div>

      <!-- 3 platos destacados: 1 por fila en mobile, 3 en una fila en desktop -->
      <div class="md:col-span-3 grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
        {
          dishes.map((dish, i) => (
            <div
              class="card-lift reveal relative"
              style={`--reveal-delay: ${i * 130}ms`}
            >
              {/* Frame decorativo, mismo lenguaje visual que la foto de "Nosotros" */}
              <div class="absolute -top-3 -left-3 w-1/3 h-1/3 border-l-4 border-t-4 border-primary-container/30 pointer-events-none z-10" />
              <div class="absolute -bottom-3 -right-3 w-1/3 h-1/3 border-r-4 border-b-4 border-primary-container/10 pointer-events-none z-10" />

              <div class="relative overflow-hidden group aspect-3/4 bg-surface-container-high">
                <Image
                  src={dish.image}
                  alt={dish.name}
                  width={552}
                  height={736}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-linear-to-t from-background/90 via-background/10 to-transparent" />
                <div class="absolute bottom-4 left-4 right-4 md:bottom-5 md:left-5 md:right-5">
                  {/* <h3 class="font-headline-lg text-on-surface text-lg md:text-xl leading-tight">
                    {dish.name}
                  </h3> */}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Carrusel de fotos: auto-scroll, imágenes solapadas con leve inclinación alternada -->
    <div class="relative reveal mt-10 md:mt-12">
      <div
        id="menu-carousel-viewport"
        class="overflow-hidden"
      >
        <div
          id="menu-carousel-track"
          class="flex items-center py-4 will-change-transform"
        >
          {
            stripLoop.map((img, i) => (
              <div
                class={`shrink-0 ${i === 0 ? "" : "-ml-8 md:-ml-10"}`}
                style={`transform: rotate(${i % 2 === 0 ? "-2deg" : "2deg"})`}
              >
                <div class="w-[60vw] sm:w-[200px] md:w-[300px] aspect-square overflow-hidden border-2 border-primary-container/40 bg-surface-container-high">
                  <Image
                    src={img}
                    alt="Doña Dominga"
                    width={600}
                    height={600}
                    class="w-full h-full object-cover"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Flechas -->
      <button
        id="menu-carousel-prev"
        type="button"
        aria-label="Ver fotos anteriores"
        class="absolute left-1 md:left-2 top-1/2 -translate-y-1/2 z-20 w-9 h-9 md:w-10 md:h-10 flex items-center justify-center bg-background/40 border border-primary-container/20 text-primary-container/80 backdrop-blur-sm hover:bg-background/70 hover:text-primary-container transition-all"
      >
        <span class="material-symbols-outlined text-xl">chevron_left</span>
      </button>
      <button
        id="menu-carousel-next"
        type="button"
        aria-label="Ver más fotos"
        class="absolute right-1 md:right-2 top-1/2 -translate-y-1/2 z-20 w-9 h-9 md:w-10 md:h-10 flex items-center justify-center bg-background/40 border border-primary-container/20 text-primary-container/80 backdrop-blur-sm hover:bg-background/70 hover:text-primary-container transition-all"
      >
        <span class="material-symbols-outlined text-xl">chevron_right</span>
      </button>
    </div>
  </div>
</section>

<script>
  function initMenuCarousel() {
    const viewport = document.getElementById("menu-carousel-viewport");
    const track = document.getElementById("menu-carousel-track");
    const prevBtn = document.getElementById("menu-carousel-prev");
    const nextBtn = document.getElementById("menu-carousel-next");
    if (!viewport || !track) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let position = 0;
    let halfWidth = 0;
    let isHovering = false;
    let lastTime: number | null = null;
    const speed = 42; // px por segundo

    function measure() {
      halfWidth = (track as HTMLElement).scrollWidth / 2;
    }
    measure();
    window.addEventListener("resize", measure);

    function wrap() {
      if (!halfWidth) return;
      if (position <= -halfWidth) position += halfWidth;
      if (position > 0) position -= halfWidth;
    }

    function applyTransform() {
      (track as HTMLElement).style.transform = `translateX(${position}px)`;
    }

    function move(delta: number) {
      position -= delta;
      wrap();
      applyTransform();
    }

    // Animación suave para el desplazamiento manual (flechas), con easing propio
    // vía rAF — independiente del auto-scroll continuo para no pelear con él.
    let manualAnimation: {
      start: number;
      from: number;
      to: number;
      duration: number;
    } | null = null;

    function animateTo(delta: number) {
      manualAnimation = {
        start: performance.now(),
        from: position,
        to: position - delta,
        duration: reduceMotion ? 0 : 450,
      };
    }

    function frame(time: number) {
      if (lastTime === null) lastTime = time;
      const dt = (time - lastTime) / 1000;
      lastTime = time;

      if (manualAnimation) {
        const elapsed = time - manualAnimation.start;
        const t = manualAnimation.duration
          ? Math.min(1, elapsed / manualAnimation.duration)
          : 1;
        const eased = 1 - Math.pow(1 - t, 3);
        position =
          manualAnimation.from +
          (manualAnimation.to - manualAnimation.from) * eased;
        applyTransform();
        if (t >= 1) {
          wrap();
          applyTransform();
          manualAnimation = null;
        }
      } else if (!isHovering && !reduceMotion) {
        move(speed * dt);
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);

    viewport.addEventListener("mouseenter", () => (isHovering = true));
    viewport.addEventListener("mouseleave", () => (isHovering = false));

    function cardStep() {
      const first = (track as HTMLElement).children[0] as
        | HTMLElement
        | undefined;
      return first ? first.getBoundingClientRect().width * 0.75 : 200;
    }

    prevBtn?.addEventListener("click", () => animateTo(-cardStep()));
    nextBtn?.addEventListener("click", () => animateTo(cardStep()));
  }

  initMenuCarousel();
</script>

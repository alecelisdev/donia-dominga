---
import SocialIcon from "./SocialIcon.astro";
---

<section
  id="servicios"
  class="py-20 md:py-section-gap bg-surface-container-low border-t border-primary-container/10 md:border-t-0"
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <span
        class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block mb-4"
      >
        Servicios
      </span>
      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6"
      >
        Para tu próxima celebración
      </h2>
      <p class="text-on-surface-variant text-body-md leading-relaxed">
        También hacemos banquetería y recibimos eventos privados —
        escríbenos y coordinamos los detalles.
      </p>
    </div>

    <!-- Banquetería y celebraciones: 2 servicios distintos, cards separadas -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      <div
        class="reveal card-lift bg-surface-container border border-primary-container/10 overflow-hidden flex flex-col"
      >
        <div
          class="aspect-4/3 flex items-center justify-center bg-surface-container-high border-b border-dashed border-primary-container/20"
        >
          <!-- TODO: foto real de banquetería -->
          <span class="material-symbols-outlined text-on-surface-variant/25 text-6xl">
            room_service
          </span>
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-1 text-center">
          <h3 class="font-headline-lg text-on-surface text-xl md:text-2xl font-bold mb-2">
            Banquetería
          </h3>
          <p class="text-on-surface-variant text-sm md:text-base leading-relaxed mb-6 flex-1">
            Servicio de banquetería para tus eventos, dentro o fuera de
            la terraza — coordinamos el menú según lo que necesites.
          </p>
          <a
            href="https://wa.me/56974131205?text=Hola!%20Quiero%20cotizar%20banquetería%20para%20un%20evento"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-shine inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-container text-on-primary-container text-xs font-bold tracking-widest uppercase hover:brightness-110 active:scale-95 transition-all"
          >
            <SocialIcon platform="whatsapp" class="w-4 h-4 shrink-0" />
            Cotizar por WhatsApp
          </a>
        </div>
      </div>

      <div
        class="reveal card-lift bg-surface-container border border-primary-container/10 overflow-hidden flex flex-col"
        style="--reveal-delay: 100ms"
      >
        <div
          class="aspect-4/3 flex items-center justify-center bg-surface-container-high border-b border-dashed border-primary-container/20"
        >
          <!-- TODO: foto real de celebraciones privadas -->
          <span class="material-symbols-outlined text-on-surface-variant/25 text-6xl">
            celebration
          </span>
        </div>
        <div class="p-6 md:p-8 flex flex-col flex-1 text-center">
          <h3 class="font-headline-lg text-on-surface text-xl md:text-2xl font-bold mb-2">
            Celebraciones Privadas
          </h3>
          <p class="text-on-surface-variant text-sm md:text-base leading-relaxed mb-6 flex-1">
            Recibimos cumpleaños, matrimonios y otros eventos privados en
            nuestro espacio — coordinamos contigo los detalles.
          </p>
          <a
            href="https://wa.me/56974131205?text=Hola!%20Quiero%20consultar%20por%20una%20celebración%20privada%20(cumpleaños%2C%20matrimonio%2C%20etc)"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-shine inline-flex items-center justify-center gap-2 px-6 py-3 bg-primary-container text-on-primary-container text-xs font-bold tracking-widest uppercase hover:brightness-110 active:scale-95 transition-all"
          >
            <SocialIcon platform="whatsapp" class="w-4 h-4 shrink-0" />
            Consultar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

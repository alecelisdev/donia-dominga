---
import { Image } from "astro:assets";
import SocialIcon from "./SocialIcon.astro";
import banqueteriaImg from "../assets/servicios/banquetería.webp";
import eventoEspecialImg from "../assets/servicios/evento-especial.webp";

const servicios = [
  {
    image: banqueteriaImg,
    alt: "Servicio de banquetería Doña Dominga",
    title: "Banquetería",
    text: "Llevamos nuestra cocina a tu evento, dentro o fuera de la terraza. Armamos el menú según el tipo de celebración, el número de invitados y lo que tengas en mente.",
  },
  {
    image: eventoEspecialImg,
    alt: "Celebración privada en Doña Dominga",
    title: "Celebraciones Privadas",
    text: "Cumpleaños, matrimonios, aniversarios y otros encuentros especiales tienen un lugar en nuestra terraza. Coordinamos contigo el espacio, el menú y los detalles para que solo te preocupes de disfrutar.",
  },
];
---

<section
  id="servicios"
  class="py-20 md:py-section-gap bg-surface-container-low border-t border-primary-container/10 md:border-t-0"
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-gutter">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 reveal">
      <span
        class="text-primary-container text-label-sm uppercase tracking-[0.3em] font-bold block mb-4"
      >
        Servicios
      </span>
      <h2
        class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-6"
      >
        Para tu próxima celebración
      </h2>
      <p class="text-on-surface-variant text-body-md leading-relaxed">
        ¿Tienes algo que celebrar? En Doña Dominga también hacemos banquetería y
        recibimos eventos privados — cuéntanos qué necesitas y coordinamos cada
        detalle contigo.
      </p>
    </div>

    <!-- Banquetería y celebraciones: mismo tamaño/proporción y marco que los platos destacados del Menú -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-20 max-w-3xl mx-auto">
      {
        servicios.map((s, i) => (
          <div class="reveal relative" style={`--reveal-delay: ${i * 130}ms`}>
            {/* Frame decorativo, mismo lenguaje visual que los platos destacados del Menú */}
            <div class="absolute -top-3 -left-3 w-1/3 h-1/3 border-l-4 border-t-4 border-primary-container/30 pointer-events-none z-10" />
            <div class="absolute -bottom-3 -right-3 w-1/3 h-1/3 border-r-4 border-b-4 border-primary-container/10 pointer-events-none z-10" />

            <div class="card-lift relative overflow-hidden aspect-3/4 bg-surface-container-high">
              <Image
                src={s.image}
                alt={s.alt}
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>

            <div class="mt-5 text-center">
              <h3 class="font-headline-lg text-on-surface text-xl md:text-2xl font-bold mb-2">
                {s.title}
              </h3>
              <p class="text-on-surface-variant text-sm md:text-base leading-relaxed">
                {s.text}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Un solo CTA para ambos servicios -->
    <div class="mt-12 text-center reveal">
      <a
        href="https://wa.me/56974131205?text=Hola!%20Quiero%20cotizar%20banquetería%20o%20consultar%20por%20una%20celebración%20privada"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shine inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-primary-container text-on-primary-container text-xs font-bold tracking-widest uppercase hover:brightness-110 active:scale-95 transition-all"
      >
        <SocialIcon platform="whatsapp" class="w-4 h-4 shrink-0" />
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>

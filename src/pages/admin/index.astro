---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Admin — Doña Dominga" noindex={true}>
  <main class="min-h-screen flex items-center justify-center px-4">
    <div class="w-full max-w-sm bg-surface-container-low border border-primary-container/20 p-6 space-y-5">
      <div>
        <h1 class="font-headline-lg text-2xl font-bold text-on-background">Panel Admin</h1>
        <p class="text-sm text-on-surface-variant">Terraza Doña Dominga</p>
      </div>

      <form id="login-form" class="space-y-4">
        <div class="space-y-1">
          <label for="password" class="text-xs uppercase tracking-wide text-on-surface-variant">Contraseña</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            class="w-full bg-surface-container px-3 py-2.5 text-on-surface border border-primary-container/20 focus:border-primary-container focus:outline-none"
          />
        </div>

        <p id="login-error" class="hidden text-sm text-error"></p>

        <button
          type="submit"
          id="login-submit"
          class="w-full bg-primary-container text-on-primary-container font-semibold py-2.5 hover:brightness-110 active:scale-95 transition-all disabled:opacity-50"
        >
          Entrar
        </button>
      </form>
    </div>
  </main>
</Layout>

<script>
  import { login, setStoredPassword, getStoredPassword } from "../../lib/sheets";

  const form = document.getElementById("login-form") as HTMLFormElement | null;
  const errorEl = document.getElementById("login-error") as HTMLParagraphElement | null;
  const submitBtn = document.getElementById("login-submit") as HTMLButtonElement | null;

  if (getStoredPassword()) {
    window.location.href = "/admin/eventos";
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    if (submitBtn) submitBtn.disabled = true;

    const formData = new FormData(form);
    const password = String(formData.get("password") ?? "");

    try {
      const result = await login(password);
      if (!result.ok) {
        if (errorEl) {
          errorEl.textContent = result.error ?? "Contraseña incorrecta.";
          errorEl.classList.remove("hidden");
        }
        if (submitBtn) submitBtn.disabled = false;
        return;
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = "No se pudo conectar. Intenta de nuevo.";
        errorEl.classList.remove("hidden");
      }
      if (submitBtn) submitBtn.disabled = false;
      return;
    }

    setStoredPassword(password);
    window.location.href = "/admin/eventos";
  });
</script>
